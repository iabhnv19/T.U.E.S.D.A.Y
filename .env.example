# Universal Cloud LLM API Key (Get a key from your AI provider)
LLM_PROVIDER=cloud
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Assistant Configuration
ASSISTANT_NAME=T.U.E.S.D.A.Y
HOTKEY_MODIFIER=right shift
HOTKEY_KEY=enter

# Voice and Language
VOICE_LANGUAGE=en-IN
VOICE_RATE=175
VOICE_VOLUME=0.9
TTS_ENGINE=auto

# Optional Defaults
WEATHER_CITY=Amritsar

# Vision & Screen Understanding (Phase 4)
VISION_MODEL=llama-3.2-11b-vision-preview

# File Search & Knowledge RAG (Phase 5)
# Comma-separated directories for search_files; defaults to Desktop, Documents, Downloads
SEARCH_DIRS=
ENABLE_RAG=true

# Browser Automation (Phase 6)
ENABLE_PLAYWRIGHT=true

# Productivity & Google Workspace Integration (Phase 7)
ENABLE_GOOGLE=false
